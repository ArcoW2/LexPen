// The ribbon LexPen ships (docs/plans/executed/PLAN-ribbon.md). Yours is ribbon.json in the data folder, made when you change
// the ribbon (its right-click: Change the ribbon); Reset goes back to this one.
// A tab: { name, groups }, and for the tab the previewer shows (Explorer's preview pane, docs/plans/PLAN-preview-handler.md
// 3.11) "previewer": true, "rows": 1, 2 or 3 (its height in rows of buttons; under three: small buttons only). That tab
// shows in LexPen's windows only while the ribbon is changed. A group: { name, corners: { left, right }, items }; a
// corner: an action, [action, params], or { action, params, open }.
// An item: "divider", or { action, params, size: "large" or "small" (the default), stack: true (under the small one
// before it, at most three in a column; or one small and one large in a column, either on top), label (shorter
// than the action's title), tip (its key tip letter), open: "dropDown" (an action with a list, such as Manage
// clipboards...: that list under it instead of its window) }.
{
  "tabs": [
    { "name": "File", "groups": [
      { "name": "File", "items": [
        { "action": "newFile", "size": "large", "label": "New\nfile" }, { "action": "openFile", "size": "large", "label": "Open\nfile..." },
        { "action": "recent.list", "params": ["files"], "label": "Recent" }, { "action": "favourites.list", "params": ["files"], "label": "Favourites", "stack": true },
        { "action": "save", "size": "large", "label": "Save file" }, { "action": "saveAs", "stack": true } ] },
      { "name": "Print", "items": [
        { "action": "print", "size": "large" } ] },
      { "name": "Folder", "items": [
        { "action": "openFolder", "size": "large", "label": "Open\nfolder" },
        { "action": "recent.list", "params": ["folders"], "label": "Recent" }, { "action": "favourites.list", "params": ["folders"], "label": "Favourites", "stack": true } ] },
      { "name": "Document tabs", "items": [
        { "action": "closeTab" }, { "action": "reopenTab", "stack": true }, { "action": "recent.list", "params": ["closed"], "stack": true } ] } ] },

    { "name": "Home", "groups": [
      { "name": "Edit", "items": [
        { "action": "indentMore", "label": "Indent" }, { "action": "indentLess", "label": "Outdent", "stack": true },
        "divider",
        { "action": "insertCharacter" }, { "action": "complete", "stack": true } ] },
      { "name": "Lines", "items": [
        { "action": "duplicateLines", "label": "Duplicate" }, { "action": "deleteLines", "label": "Delete", "stack": true },
        { "action": "joinLines", "label": "Join", "stack": true } ] },
      { "name": "Clipboard", "corners": { "left": "clipboards.pane", "right": { "action": "clipboards.pane", "open": "dropDown" } }, "items": [
        { "action": "paste", "size": "large" },
        { "action": "pasteImage", "label": "Image", "stack": true }, { "action": "cut", "stack": true }, { "action": "copy", "stack": true },
        { "action": "clipboard.exchange", "label": "Exchange", "stack": true } ] },
      { "name": "Find", "items": [
        { "action": "find", "size": "large" }, { "action": "replace", "stack": true },
        { "action": "findPrevious" }, { "action": "findNext", "stack": true },
        { "action": "searchInFiles" }, { "action": "searchReplace", "stack": true }, { "action": "findReferences", "stack": true } ] },
      { "name": "Occurrences", "corners": { "right": "occurrences.field" }, "items": [
        { "action": "occurrences.show", "label": "Show" }, { "action": "occurrences.clear", "label": "Clear", "stack": true } ] },
      { "name": "Go to", "items": [
        { "action": "goToLine", "label": "Line" }, { "action": "goToDefinition", "label": "Definition", "stack": true } ] },
      { "name": "Bookmarks", "corners": { "left": "bookmarks.pane", "right": { "action": "bookmarks.pane", "open": "dropDown" } }, "items": [
        { "action": "bookmarkToggleFree", "size": "large", "label": "Toggle bookmark" },
        { "action": "bookmarkNext", "params": [-1], "label": "Previous" },
        { "action": "bookmarkNext", "params": [1], "label": "Next", "stack": true } ] } ] },

    { "name": "Arrange", "groups": [
      { "name": "Select", "items": [
        { "action": "selectAll", "size": "large" },
        { "action": "selectLine", "label": "Line" }, { "action": "blockSelect", "label": "Block", "stack": true },
        { "action": "selectInsideBrackets", "label": "Brackets", "stack": true } ] },
      { "name": "Mode", "items": [
        { "action": "editMode.set", "params": ["text"], "label": "Text mode" }, { "action": "editMode.set", "params": ["column"], "label": "Column mode", "stack": true },
        { "action": "editMode.set", "params": ["hex"], "label": "Hex mode", "stack": true } ] },
      { "name": "Sort", "corners": { "right": "edit.sortWindow" }, "items": [
        { "action": "edit.sortWindow", "size": "large" },
        { "action": "edit.sortAsc" }, { "action": "edit.sortDesc", "stack": true }, { "action": "edit.sortAgain", "stack": true } ] },
      { "name": "History", "items": [
        { "action": "undo", "size": "large" }, { "action": "redo", "stack": true } ] } ] },

    { "name": "Review", "groups": [
      { "name": "Highlights", "corners": { "left": "highlight.list", "right": { "action": "highlight.list", "open": "dropDown" } }, "items": [
        { "action": "highlight.toggle" }, { "action": "highlight.note", "stack": true }, { "action": "highlight.remove", "stack": true } ] } ] },

    { "name": "View", "groups": [
      { "name": "Document", "items": [
        { "action": "editor.toggle", "size": "large" }, { "action": "preview.toggle", "size": "large" } ] },
      { "name": "Text", "items": [
        { "action": "wrap.toggle", "size": "large" },
        { "action": "lineNumbers.set", "label": "Line numbers" }, { "action": "ruler.toggle", "stack": true },
        { "action": "formatBar.toggle", "stack": true } ] },
      { "name": "Files and finding", "items": [
        { "action": "panel", "params": ["folder"] }, { "action": "panel", "params": ["search"], "stack": true },
        { "action": "panel", "params": ["bm"], "stack": true } ] },
      { "name": "The document", "items": [
        { "action": "panel", "params": ["outline"] }, { "action": "panel", "params": ["hls"], "stack": true },
        { "action": "panel", "params": ["cols"], "label": "Columns", "stack": true } ] },
      { "name": "Editing", "items": [
        { "action": "panel", "params": ["chars"] }, { "action": "panel", "params": ["clips"], "stack": true },
        { "action": "panel", "params": ["sort"], "stack": true } ] },
      { "name": "Macros", "items": [
        { "action": "panel", "params": ["macros"] }, { "action": "panel", "params": ["step"], "stack": true } ] },
      { "name": "LexPen", "items": [
        { "action": "panel", "params": ["settings"] }, { "action": "panel", "params": ["commands"], "label": "Keyboard shortcuts", "stack": true },
        { "action": "panel", "params": ["messages"], "stack": true },
        { "action": "panel", "params": ["themesets"] }, { "action": "panel", "params": ["themecolours"], "stack": true },
        { "action": "panel", "params": ["projects"], "label": "Projects", "stack": true } ] },
      { "name": "Window", "items": [
        { "action": "zoomIn" }, { "action": "zoomOut", "stack": true }, { "action": "zoomReset", "stack": true },
        "divider",
        { "action": "theme.day", "size": "large", "label": "Day" }, { "action": "theme.night", "size": "large", "label": "Night" } ] } ] },

    { "name": "Tools", "groups": [
      { "name": "Macros", "corners": { "right": "macro.manage" }, "items": [
        { "action": "macro.record", "size": "large" },
        { "action": "macro.play", "size": "large", "label": "Play" }, { "action": "macro.playTimes", "label": "Play X times...", "stack": true } ] },
      { "name": "Compare", "items": [
        { "action": "compareFiles", "size": "large" },
        { "action": "compareFolders", "stack": true },
        { "action": "comparePrevious" }, { "action": "compareNext", "stack": true }, { "action": "compareClose", "stack": true } ] },
      { "name": "Settings", "items": [
        { "action": "settings", "size": "large" },
        { "action": "themeColours" }, { "action": "commands", "label": "Keyboard shortcuts", "stack": true } ] } ] },

    { "name": "Preview", "previewer": true, "rows": 2, "groups": [
      { "name": "Find", "items": [
        { "action": "find" }, { "action": "findNext", "label": "Next", "stack": true },
        { "action": "findPrevious", "label": "Previous" }, { "action": "occurrences.bar", "label": "Occurrences", "stack": true } ] },
      { "name": "Go to", "items": [
        { "action": "positionBack", "label": "Back" }, { "action": "positionForward", "label": "Forward", "stack": true },
        { "action": "block.next", "label": "Block" }, { "action": "outline.next", "label": "Section", "stack": true } ] },
      { "name": "Bookmarks", "items": [
        { "action": "bookmarkToggleFree", "label": "Toggle" }, { "action": "bookmarkList", "label": "List", "open": "dropDown", "stack": true },
        { "action": "bookmarkNext", "params": [-1], "label": "Previous" }, { "action": "bookmarkNext", "params": [1], "label": "Next", "stack": true } ] },
      { "name": "Highlights", "items": [
        { "action": "highlight.toggle" }, { "action": "highlight.fromSelection", "label": "From selection", "stack": true },
        { "action": "highlight.note", "label": "Note" }, { "action": "highlight.remove", "label": "Remove", "stack": true },
        { "action": "highlight.next", "params": [-1], "label": "Previous" }, { "action": "highlight.next", "params": [1], "label": "Next", "stack": true },
        { "action": "highlight.list", "label": "List", "open": "dropDown" }, { "action": "highlight.keep", "label": "Keep adjusted", "stack": true },
        { "action": "highlight.clear", "label": "Remove all" } ] },
      { "name": "View", "items": [
        { "action": "editor.toggle", "label": "Source" }, { "action": "preview.toggle", "label": "Preview", "stack": true },
        { "action": "hex.toggle", "label": "Hex" }, { "action": "chooseLanguage", "label": "Language", "stack": true },
        { "action": "theme.day", "label": "Day" }, { "action": "theme.night", "label": "Night", "stack": true },
        { "action": "zoomIn" }, { "action": "zoomOut", "stack": true }, { "action": "zoomReset" } ] },
      { "name": "File", "items": [
        { "action": "print" }, { "action": "previewer.open", "stack": true },
        { "action": "copy" }, { "action": "file.copy", "label": "Copy name", "stack": true } ] } ] }
  ]
}
