<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Major.minor; the last number is the git commit count (see GitVersion). -->
    <VersionBase>1.0</VersionBase>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>img\icon\lexpen.ico</ApplicationIcon>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishReadyToRun>true</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- Publish only what runs: no symbols, no IntelliSense xml, and no second WebView2Loader.dll
         under runtimes\ (the package's native asset already puts one next to the exe). -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <WebView2NeverCopyLoaderDllToOutputDirectory>true</WebView2NeverCopyLoaderDllToOutputDirectory>
    <!-- One exe: LexPen.dll, its .NET json files and the libraries inside; WebView2Loader.dll (native) stays next to
         it, so nothing is unpacked to a temp folder. -->
    <PublishSingleFile>true</PublishSingleFile>
    <DefaultItemExcludes>$(DefaultItemExcludes);node_modules\**;publish\**;tests\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <!-- What you may read and copy (keys, settings, language packs, themes): next to the exe. -->
    <Content Include="defaults\**" CopyToOutputDirectory="PreserveNewest" />
    <!-- The icons of the compare entries in Explorer's right-click menu (ExplorerMenu.cs): next to the exe. -->
    <Content Include="img\icon\compare-left.ico;img\icon\compare-to.ico" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The page's files: inside the exe (WebFiles). -->
    <EmbeddedResource Include="web\**" LogicalName="web\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="$(ApplicationIcon)" LogicalName="app.ico" />
    <!-- Written to the data folder the first time; the file in docs\examples is the one source. -->
    <EmbeddedResource Include="docs\examples\tab-colours.json" LogicalName="tab-colours.json" />
    <InternalsVisibleTo Include="LexPen.Tests" />
    <!-- Shown in the About window. -->
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::UtcNow.ToString('o'))" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

  <!-- The build number is the git commit count, so each commit gets its own version: 1.0.1, 1.0.2, ...
       The short commit hash goes into the About window. Without git (or before the first commit) it is 1.0.0.
       Skipped for the IDE's background design-time builds. -->
  <Target Name="GitVersion" BeforeTargets="BeforeBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Exec Command="git rev-list --count HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" ContinueOnError="true">
      <Output TaskParameter="ConsoleOutput" PropertyName="BuildNumber" />
      <Output TaskParameter="ExitCode" PropertyName="GitExitCode" />
    </Exec>
    <Exec Command="git rev-parse --short HEAD" WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low" IgnoreExitCode="true" ContinueOnError="true" Condition="'$(GitExitCode)' == '0'">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitCommit" />
    </Exec>
    <PropertyGroup>
      <BuildNumber Condition="'$(GitExitCode)' != '0'">0</BuildNumber>
      <Version>$(VersionBase).$(BuildNumber)</Version>
    </PropertyGroup>
    <ItemGroup Condition="'$(GitCommit)' != ''">
      <AssemblyMetadata Include="Commit" Value="$(GitCommit)" />
    </ItemGroup>
    <Message Importance="high" Text="LexPen version $(Version) $(GitCommit)" />
  </Target>

  <!-- The Explorer extension (shell\LexPenShell.cpp, docs/plans/40-PLAN-explorer-compare-two.md): LexPenShell.dll next
       to the exe, built with Visual Studio's C++ tools (shell\build.cmd); without them a warning and no DLL, and the
       setting explorerShell then keeps today's entries. Also into a publish. -->
  <Target Name="LexPenShell" AfterTargets="Build" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="shell\LexPenShell.cpp;shell\LexPenShell.def;shell\build.cmd" Outputs="$(TargetDir)LexPenShell.dll">
    <Exec Command="&quot;$(ProjectDir)shell\build.cmd&quot; &quot;$(TargetDir).&quot; &quot;$(ProjectDir)$(IntermediateOutputPath)shell&quot;" />
  </Target>
  <Target Name="PublishLexPenShell" AfterTargets="Publish" Condition="Exists('$(TargetDir)LexPenShell.dll')">
    <Copy SourceFiles="$(TargetDir)LexPenShell.dll" DestinationFolder="$(PublishDir)" ContinueOnError="true" />
  </Target>

  <!-- The WebView2 package always references its WPF control too; this app only uses WinForms. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
