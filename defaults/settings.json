// LexPen's settings with their defaults. Do not change this file: your own settings.json in
// %LOCALAPPDATA%\LexPen holds only what you changed (Options > Settings writes it; you may edit it by hand,
// and copy it to another PC). A changed file applies at once in every window.
{
  // ---------- General ----------
  "languageNames": {},            // names of languages of your own, before the packs' own names and aliases: a
                                  // markdown fence or an embedded block naming "bash" can be TCC: { "bash": "tcc" }
  "newWindowProject": "same",     // a new window: "same" (the project of the last window used on this desktop)
                                  // or "new" (always a new project); never the project for viewing
  "viewProject": 0,               // the project View in LexPen opens files and folders in: its id (Manage projects);
                                  // 0 is the project named "View" (made on the first view)
  "compareProject": 0,            // the project a compare from Explorer (Compare to, --compare) opens in: its id
                                  // (Manage projects); 0 is the project named "Compare" (made on the first compare),
                                  // -1 the project for viewing
  "viewReadOnly": true,           // View in LexPen opens a file read-only (the tab menu's Read-only takes that off);
                                  // false: it can be edited at once
  "keepUnnamedProjects": true,    // a project you did not name, with files, when its last window closes: kept as
                                  // "Project n" (true) or dropped (false); one without files is always dropped
  "projectsSort": "used-desc",    // Manage projects: the order of the list, "name", "created" or "used", then
                                  // "-asc" or "-desc"
  "followWindows": true,          // light or dark as Windows is (Settings > Personalization > Colors), at once
  "themeLight": "light",          // the app's theme for light mode (a file name in themes\ without .json)
  "themeDark": "dark",            // the app's theme for dark mode
  "theme": "light",               // "light" or "dark": the mode when not following Windows (Day / night)
  "openIn.*": "",                 // how a file opens, per language ("openIn.markdown", "openIn.sql", ...): "edit",
                                  // "split" (editor and preview), "preview", or "" as the language pack says

  // ---------- Editor ----------
  "editorFont": "",               // a font name; "" is Consolas
  "editorSize": 0,                // in points; 0 is 10.5 pt (also Ctrl+mouse wheel in the editor)
  "editorLine": 0,                // line height, times the font size; 0 is 1.3
  "editorThemeLight": "",         // the editor in light mode: "" is the app's theme, else a theme of its own
  "editorThemeDark": "",          // the editor in dark mode
  "tabSize": 4,                   // where the tab stops are: a tab after text goes to the next one (1 to 16)
  "indentSize": 2,                // where the indent stops are: Tab in a line's indentation, indent, and a tab
                                  // there (1 to 16); a language pack can set both (tabSize, indentSize)
  "overviewWidth": 20,            // the editor's scroll bars: their width in px (10 to 40); the vertical one is the overview
                                  // ruler, the marks on it are per window (defaultLayout: overview.*)
  "compareWhitespace": false,     // comparing: spaces and tabs count only as a separation
  "compareCase": false,           // comparing: upper and lower case count as the same
  "compareStep": "block",         // comparing: F7 goes to the next "block" of changed lines, or the next changed "line"
  "compareStrip": true,           // comparing: the line strip below the panes
  "explorerCompare": false,       // Explorer's right-click menu: Select left side to compare, then Compare to <name>
  "explorerView": false,          // ...View in LexPen, on files and folders (the project for viewing, viewProject)
  "explorerEdit": false,          // ...Edit in LexPen, on files (as opening one, never in the project for viewing)
  "explorerPlace": "group",       // ...the LexPen items: "group" (next to each other, a line above and below) or
                                  // "submenu" (one item LexPen with them)
  "gutter.cursor": true,          // the cursor's line marked in the gutter, in the ruler's cursor colour
  "bracketHighlight": "colour",   // the pair or word set (begin ... end) around the cursor: "colour", "underline"
                                  // (in the find box's colour) or "off"
  "closeBrackets": false,         // typing an opening sign or quote adds its closer
  "indentGuides": "comment",      // a line at every enclosing indent: "comment" (its colour), "rainbow" (a colour per
                                  // level, theme colours guide1 to guide6), "colour" (indentGuideColour) or "off"
  "indentGuideColour": "accent",  // for "colour": a theme colour's name or "#rrggbb"
  "indentGuideIntensity": 55,     // percent of the guides' colour, the rest see-through
  "indentGuideCursor": true,      // the guide of the block at the cursor in its own colour
  "indentGuideCursorColour": "find-box", // a theme colour's name or "#rrggbb"
  "indentGuideCursorIntensity": 100,
  "outlineMerged": false,         // the outline's groups together, in line order (off: a header per group)
  "outlineBullets": true,         // a bullet in the group's colour in front of each outline entry
  "sneakTheme": "",               // the theme of the outline's sneak preview (a long click); "": the editor's, tinted
  "scrollMargin": 8,              // columns: the editor scrolls sideways when the cursor comes this close to the edge
  "leftWraps": true,              // Left at the first column goes on to the end of the line above
  "homeStop": false,              // Home goes to column 1 (off: to the first non-blank character first)
  "completeDelay": 0,             // ms after the last typed word character before the completion list opens by
                                  // itself (0: only with Ctrl+Space)
  "revealInView": "stay",         // a line jumped to (find, search result, compare difference, bookmark, highlight,
                                  // Go to line, a click in the outline) on screen: "stay" or "center"
  "revealOutOfView": "keep",      // ... not on screen: "keep" (revealLines from the edge it comes in at) or "center"
  "revealLines": 5,               // a line jumped to no closer than this to the top or bottom of the view
  "jumpLines": 10,                // a cursor move of more lines than this, without typing, is a jump: the place it left
                                  // is kept for Position back (a found item always)
  "scrollMovesCursor": false,     // Ctrl+Up / Ctrl+Down: the cursor moves a line along with the text
  "virtualSpace": false,          // the cursor can be past the end of a line: it keeps its column on short lines,
                                  // and typing there fills the line with spaces first (a monospaced font only)
  "locateCursor": true,           // a short tap on Ctrl alone: rings shrink onto every cursor (a marker at the edge
                                  // for one out of view)
  "locateCursorTap": 400,         // ms: the longest press of Ctrl that counts as a tap
  "locateCursorJump": false,      // a double tap on Ctrl scrolls to the cursor first
  "columnGuideStart": 0,          // a faint line after this many characters (0: none)
  "columnGuideStep": 0,           // then one every so many characters (0: only the first)
  "columnGuideExtra": 0,          // one more guide of its own, as 80 (0: none)
  "columnGuideColour": "border",   // the column guides' theme colour: border, find-current (orange), find-box, accent
                                  // (blue), tip (green), important (purple), caution (red), warning (brown)
  "inlineCodeIntensity": 100,     // the box behind code within a line: 100 the theme colour inlineCode, less towards the background (0: no box), more (to 200) further from it
  "previewHighlightStyle": "background",  // a highlight in the preview: "background" or "underline" (the editor: highlightStyle)
  "previewHighlightColour": "highlight",   // its colour: a theme colour's name (the preview theme's own) or "#rrggbb"
  "previewHighlightIntensity": 100,        // percent: 100 the colour, less towards the background, more (to 200) further from it
  "highlightsStore": "store",     // where highlights are kept: "store" (LexPen's) or "beside" (name.ext.lph next to the file)
  "highlightStyle": "background",  // a highlighted part of the text: a "background" colour or "underline"d
  "highlightColour": "highlight", // its colour: a theme colour's name (the theme's highlight, yellow) or "#rrggbb"
  "highlightIntensity": 100,      // percent: 100 the colour, less towards the background, more (to 200) further from it
  "columnGuideIntensity": 40,     // intensity of the column guides: percent of their colour, the rest the background
  "helperLineIntensity": 20,      // intensity of the helper lines: percent of the line's colour, the rest the
                                  // theme's background (a colour from Other colour... is drawn as picked)
  "tabStopIntensity": 50,         // intensity of the tab stop lines: percent of the line's colour, the rest the
                                  // theme's background (a colour from Other colour... is drawn as picked)
  "showWhitespace": false,        // in the editor: a space as a small dot, a tab as an arrow
  "showLineEnds": false,          // in the editor: a sign at the end of each line (CRLF or LF)
  "showSpecialChars": true,       // in the editor: control characters, invisible signs and bytes the encoding could
                                  // not read as their code in a box (0x1B, U+200B, 0xAB)

  // ---------- Preview ----------
  "lineBreaks": false,            // a single line break starts a new line (off: joins the lines, as on GitHub)
  "zoom": 1,                      // preview zoom: 1 is 100%, 0.5 to 3
  "previewThemeLight": "",        // the preview in light mode: "" is the app's theme, else a theme of its own
  "previewThemeDark": "",         // the preview in dark mode (as "light": a light preview next to a dark editor)

  // ---------- Files ----------
  "backup": true,                 // saving keeps the old file as name.ext.bak
  "showBackupFiles": false,       // the folder pane lists the .bak files too
  "trimTrailing": true,           // saving removes the spaces and tabs at the line ends of the whole file (a language
                                  // can keep some, or never trim: trimTrailing in its language.yaml)
  "newFileEol": "crlf",           // line ends of a new file (and of one without a line break): "crlf", "lf" or "cr"
  "askSaveDrafts": true,          // closing LexPen asks to save changed drafts too (false: they stay drafts, unasked)

  // ---------- Tabs ----------
  "tabOrder": "recent",           // Document order (Ctrl+PgDn): "recent" (recently used) or "tabs" (the tab bar)
  "scrollTogether": "distance",   // scroll together (the button between the panes): "distance" (as the panes are aligned now) or "line" (the same line number)
  "movePinned": true,             // closing a pane or window moves its pinned tabs to the main pane / another
                                  // open window of the same project

  // ---------- Find ----------
  "findShared": false,            // one find for both panes (off: each pane its own)
  "replacePreview": true,         // Search panel: Replace all / per file in the selection, the file, the open files
                                  // show the preview window first (off: at once; Preview... still shows it)
  "replacePreviewFiles": true,    // the same for Files in folder (files not open are written without undo)
  "findWrap": "end",              // past the last match: "end" (stop, with a message), "around" (go on from the top)
                                  // or "origin" (go on from the top, stop where the search started)
  "findHistory": 20,              // searches (and replacements) kept, for all windows: Up / Down in a find field
                                  // step through them, Alt+Down opens the list
  "findMark": "background",       // how found text is marked: "background", "outline" or "both"
  "findGutter": true,             // the line numbers of lines with found text marked the same way (the current one too)

  // ---------- App ----------
  "appFont": "",                  // menus, tabs, panes, bars and dialogs; "" is Segoe UI
  "appSize": 0,                   // in points; 0 is 9.75 pt
  "statusFont": "",               // the bottom bar; "" is the app font
  "statusSize": 0,                // in points; 0 is the app's size for small texts

  // ---------- Layout ----------
  // What is open and shown in a window is kept per window, with its session (so per project). This is the layout
  // a new project starts with (View > Layout > Save as default); a name left out here is the value below.
  "defaultLayout": {
    "sidebar": true,              // the sidebar (Folder or Search) shown when a folder is open
    "sideView": "folder",         // "folder" or "search"
    "sidebarWidth": 0,            // in px; 0 is the standard width
    "outline": false,             // the outline next to each editor pane
    "outlineWidth": 0,            // in px; 0 is the standard width
    "orient": "v",                // two panes: "v" side by side, "h" above each other
    "ratio": 50,                  // two panes: the first pane's share, in percent
    "editShare": 0,               // editor and preview side by side: the editor's share, 0.1 to 0.9; 0 is half
    "searchScope": "file",        // the sidebar search: "file", "open" (the open files) or "folder"
    "tree": "all",                // the folder pane: "all" files, or "known" (the file types the language packs know)
    "sort": "name",               // the folder pane: by "name" or "modified"
    "sortDesc": false,            // the folder pane: descending
    "formatBar": true,            // the bar with bold, headings, lists, ... above the editor
    "ruler": false,               // the ruler above the editor: columns, the cursor's column, guides; a click on it
                                  // sets a tab stop (Tab goes there, Shift+Tab back) or a helper line (only shows),
                                  // per document, kept for the last 100 files with lines
    "wrap": true,                 // wrap long lines in the editor; Alt+Z
    "previewWrap": true,          // wrap long lines in the code blocks of the preview
    "tabBar": "scroll",           // tabs that do not fit: "scroll" (one row that scrolls), "menu" (one row, a menu
                                  // lists the tabs out of view) or "rows" (several rows, all tabs visible)
    "lineNumbers": "all",         // the gutter (View > Gutter): line numbers "none", "tens" (a number every 10 lines,
                                  // a dash at 5, a dot on the other lines) or "all"
    "lineNumberCount": "absolute", // "absolute", or "relative" to the cursor line (that line shows its own number)
    "gutter.bookmarks": true,     // the gutter columns left of the text
    "gutter.changes": true,       // lines changed since the last save
    "gutter.git": true,           // lines changed since the last commit
    "gutter.folds": true,
    "overview.find": true,        // the marks on the editor's scroll bar: the lines with a find match
    "overview.changes": true,     // ...the lines changed since the last save
    "overview.git": true,         // ...the lines changed since the last commit
    "overview.bookmarks": true,   // ...the bookmarks
    "overview.highlights": true,  // ...the highlights
    "overview.compare": true      // ...comparing, the differences
  }
}
