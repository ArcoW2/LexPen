// Dark Ink and aged paper: the backgrounds and the text in the blue of Dark ocean, the lines, the accent, the
// selection and the highlights in the yellow of Dark parchment.
// A theme lists only what differs from its base; the base may be any theme. The names are in the README (Themes).
{
  "name": "Dark Ink and aged paper (blue/yellow)",
  "description": "blue ink, yellow lines and highlights",
  "base": "dark",
  "colors": {
    // Blue (Dark ocean): backgrounds and text.
    "bg": "#161c27",
    "bgSide": "#1b2230",
    "bgBar": "#202839",
    "bgCode": "#1d2533",
    "bgBarDim": "#131822",
    "fg": "#d8e0ee",
    "fgDim": "#909cb0",
    "inlineCode": "#313743",
    "inlineCodeFg": "#a1c4f6",

    // Yellow (Dark parchment): borders, accent, selection, highlights, the active pane, matching brackets.
    "border": "#463d2a",
    "accent": "#e0b84a",
    "active": "rgba(224, 184, 74, .18)",
    "select": "#5c4a1f",
    "highlight": "#8d8300",
    "occurrenceHit": "#635f0e",
    "occurrenceBox": "#fff027",
    "paneActive": "#e0b84a",
    "bracketMatch": "rgba(224, 184, 74, .35)"
  }
}
